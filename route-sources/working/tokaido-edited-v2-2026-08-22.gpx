    <name>Fujisawa Station</name>
    <desc>rail-bailout · demonstration / unverified</desc>
  </wpt>
  <wpt lat="35.256" lon="139.155">
    <name>Odawara Station</name>
    <desc>rail-bailout · Shinkansen stop. Last dense-rail point before the Hakone crossing. · demonstration / unverified</desc>
  </wpt>
  <wpt lat="35.213298" lon="139.063847">
    <name>Hatajuku bus stop (east slope)</name>
    <desc>rail-bailout · Bus, not rail. This is the realistic east-slope exit once the trail is committed to. Timetable unverified. · medium / imported</desc>
  </wpt>
  <wpt lat="35.19239" lon="139.026334">
    <name>Moto-Hakone (Lake Ashi) bus</name>
    <desc>rail-bailout · West-side services connect to Mishima. The decisive stop-or-continue point of the Hakone day. · medium / imported</desc>
  </wpt>
  <wpt lat="35.126" lon="138.911">
    <name>Mishima Station</name>
    <desc>rail-bailout · Shinkansen stop. · demonstration / unverified</desc>
  </wpt>
