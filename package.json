{
  "name": "samwise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Samwise — offline-first field companion for the Tokyo-to-Kyoto Tokaido walk. Demonstration data only.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:build": "vitest run --project build",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:build",
    "fixtures": "node scripts/build-fixtures.mjs",
    "route:import": "node scripts/import-traced-route.mjs",
    "route:gpx": "node --experimental-strip-types scripts/export-master-gpx.mjs",
    "route:apply-edits": "node scripts/apply-route-edits.mjs",
    "route:import-upstream": "node scripts/import-kaidotrail.mjs",
    "route:audit": "node scripts/audit-traced-files.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
